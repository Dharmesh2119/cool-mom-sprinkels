<style type="text/css">
{% render 'common-css', section: section, margin: 12 %}

/* Senior-Architect Design for Shop Sprinkles By Inner Tabs & Cards */
#s--{{ section.id }} {
  width: 100%;
  clear: both;
}

#s--{{ section.id }} .tab__container {
  max-width: 1280px;
  margin: 0 auto;
  padding: 20px 24px 80px;
  box-sizing: border-box;
  width: 100%;
}

/* Heading */
#s--{{ section.id }} .section__heading {
  margin-bottom: 24px;
  text-align: center;
}

#s--{{ section.id }} .section__heading--heading h2,
#s--{{ section.id }} .section__heading h2 {
  font-family: 'Fraunces', Georgia, serif;
  font-size: 32px;
  font-weight: 700;
  color: #F07290;
  text-align: center;
  margin: 0;
  line-height: 1.25;
}

/* Menu Selector Pill Container */
#s--{{ section.id }} .tab__holder {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  margin: 0 auto 48px auto;
  padding: 0;
  box-sizing: border-box;
}

#s--{{ section.id }} .cm-tabs-pill-nav {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 6px;
  background-color: #FAF0F2;
  border-radius: 50px;
  padding: 20px;
  max-width: 100%;
  box-sizing: border-box;
}

#s--{{ section.id }} .cm-tab-item {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  color: #261514;
  background: transparent;
  border-radius: 50px;
  padding: 15px;
  margin: 0;
  cursor: pointer;
  white-space: nowrap;
  border: none;
  outline: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  line-height: 1;
  user-select: none;
}

#s--{{ section.id }} .cm-tab-item:hover {
  color: #F07290;
}

#s--{{ section.id }} .cm-tab-item.tab--active {
  background-color: #F07290;
  color: #FFFFFF;
  box-shadow: 0 4px 14px rgba(240, 114, 144, 0.35);
}

/* Mobile Selection Dropdown */
#s--{{ section.id }} .cm-tabs-mobile-select-wrap {
  display: none;
}

#s--{{ section.id }} .cm-tabs-select-box {
  position: relative;
  width: 100%;
  max-width: 340px;
  margin: 0 auto;
  box-sizing: border-box;
}

#s--{{ section.id }} .cm-tabs-select {
  width: 100%;
  height: 48px;
  background-color: #FAF0F2;
  border: 1.5px solid #F07290;
  border-radius: 50px;
  padding: 0 46px 0 22px;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  color: #F07290;
  cursor: pointer;
  -webkit-appearance: none;
  -moz-appearance: none;
  appearance: none;
  outline: none;
  box-shadow: 0 4px 14px rgba(240, 114, 144, 0.15);
  transition: all 0.2s ease;
  box-sizing: border-box;
  display: block;
  line-height: 46px;
}

#s--{{ section.id }} .cm-tabs-select:focus,
#s--{{ section.id }} .cm-tabs-select:active {
  border-color: #e25b7b;
  box-shadow: 0 4px 16px rgba(240, 114, 144, 0.28);
}

#s--{{ section.id }} .cm-tabs-select option {
  background-color: #ffffff;
  color: #261514;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 14px;
  font-weight: 600;
  padding: 10px 14px;
}

#s--{{ section.id }} .cm-tabs-select-arrow {
  position: absolute;
  right: 18px;
  top: 50%;
  transform: translateY(-50%);
  pointer-events: none;
  width: 16px;
  height: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
}

#s--{{ section.id }} .cm-tabs-select-arrow svg {
  width: 16px;
  height: 16px;
  display: block;
}

/* Tabs Content Grid */
#s--{{ section.id }} .featured-tabs__content {
  display: none;
  width: 100%;
  max-width: 1280px;
  margin: 0 auto;
  box-sizing: border-box;
}

#s--{{ section.id }} .featured-tabs__content.tab--show {
  display: flex;
  flex-wrap: wrap;
}

#s--{{ section.id }} .card--holder {
  padding: 0 12px 40px;
  box-sizing: border-box;
  display: flex;
}

/* Product Card Styling matching default collection card behavior */
#s--{{ section.id }} .card--default {
  background: transparent;
  border: none;
  text-align: left;
  width: 100%;
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100%;
}

#s--{{ section.id }} .card--default .card__img-wrap {
  position: relative;
  width: 100%;
  border-radius: 24px;
  overflow: hidden;
  background-color: #F8F8F8;
  aspect-ratio: 1 / 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

#s--{{ section.id }} .card--default .card__img-link {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 24px;
  overflow: hidden;
}

#s--{{ section.id }} .card--default .card__img-link img,
#s--{{ section.id }} .card--default img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  border-radius: 24px;
  transition: transform 0.35s ease;
}

#s--{{ section.id }} .card--default:hover .card__img-link img {
  transform: scale(1.025);
}

#s--{{ section.id }} .card--default .card__img--secondary {
  display: none;
}

/* Add to Cart Button (Hover Slide-Up Pill) */
#s--{{ section.id }} .card--default .cm-product-card__atc {
  position: absolute;
  bottom: 16px;
  left: 50%;
  transform: translate(-50%, 25px);
  opacity: 0;
  visibility: hidden;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  height: 42px;
  min-height: 42px;
  padding: 0 18px;
  border-radius: 30px;
  background-color: #F07290;
  color: #ffffff;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 13px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  line-height: 1;
  white-space: nowrap;
  text-decoration: none;
  border: none;
  outline: none;
  cursor: pointer;
  box-shadow: 0 4px 14px rgba(240, 114, 144, 0.35);
  z-index: 5;
  pointer-events: none;
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease, visibility 0.25s ease, background-color 0.2s ease, box-shadow 0.2s ease;
  width: max-content;
  max-width: calc(100% - 24px);
  box-sizing: border-box;
  -webkit-appearance: none;
  appearance: none;
}

#s--{{ section.id }} .card--default .cm-product-card__atc-icon {
  width: 16px;
  height: 16px;
  min-width: 16px;
  min-height: 16px;
  fill: #ffffff;
  flex-shrink: 0;
  display: inline-block;
  vertical-align: middle;
}

#s--{{ section.id }} .card--default .cm-product-card__atc-icon path {
  fill: #ffffff;
}

#s--{{ section.id }} .card--default .cm-product-card__atc span {
  color: #ffffff;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 13px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  white-space: nowrap;
  flex-shrink: 0;
}

#s--{{ section.id }} .card--default:hover .cm-product-card__atc,
#s--{{ section.id }} .card--default:focus-within .cm-product-card__atc {
  opacity: 1;
  visibility: visible;
  transform: translate(-50%, 0);
  pointer-events: auto;
}

#s--{{ section.id }} .card--default .cm-product-card__atc:hover {
  background-color: #e25b7b;
  box-shadow: 0 6px 18px rgba(240, 114, 144, 0.45);
}

#s--{{ section.id }} .card--default .card__tags {
  position: absolute;
  top: 12px;
  left: 12px;
  z-index: 2;
}

#s--{{ section.id }} .card--default .tag--soldout {
  background-color: #000000;
  color: #ffffff;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  padding: 4px 8px;
  border-radius: 4px;
  display: inline-block;
}

/* Card Info Below Image */
#s--{{ section.id }} .card--default .card__info {
  padding: 14px 0 0;
  text-align: left;
  display: flex;
  flex-direction: column;
  gap: 3px;
  flex: 1 1 auto;
  box-sizing: border-box;
}

#s--{{ section.id }} .card--default .card__brand {
  font-family: 'Fraunces', Georgia, serif;
  font-size: 16px;
  font-weight: 700;
  color: #261514;
  text-decoration: none;
  display: block;
  margin: 0;
  line-height: 1.25;
}

#s--{{ section.id }} .card--default .card__title {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 14px;
  font-weight: 400;
  color: #6F5B58;
  line-height: 1.35;
  text-decoration: none;
  display: block;
  margin: 0;
  word-break: break-word;
  transition: color 0.15s ease;
}

#s--{{ section.id }} .card--default .card__title:hover {
  color: #F07290;
}

#s--{{ section.id }} .card--default .card__reviews {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  white-space: nowrap;
  gap: 4px;
  margin: 4px 0 2px 0;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

#s--{{ section.id }} .card--default .card__review-stars {
  color: #EAA824;
  font-size: 13px;
  letter-spacing: 0.5px;
  line-height: 1;
  flex-shrink: 0;
}

#s--{{ section.id }} .card--default .card__review-score {
  font-size: 13px;
  font-weight: 700;
  color: #261514;
  line-height: 1;
  flex-shrink: 0;
  margin-left: 2px;
}

#s--{{ section.id }} .card--default .card__review-count {
  font-size: 13px;
  font-weight: 400;
  color: #6F5B58;
  line-height: 1;
  white-space: nowrap;
  flex-shrink: 0;
}

#s--{{ section.id }} .card--default .card__price {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 15px;
  font-weight: 700;
  color: #261514;
  margin-top: auto;
  padding-top: 4px;
  display: block;
}

/* Show More Button */
#s--{{ section.id }} .showMore {
  width: 100%;
  margin-top: 10px;
  margin-bottom: 20px;
  display: flex;
  justify-content: center;
}

#s--{{ section.id }} .showMore .button {
  background-color: #F07290;
  color: #ffffff;
  border-radius: 50px;
  padding: 12px 32px;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.8px;
  text-transform: uppercase;
  text-decoration: none;
  transition: background-color 0.15s ease;
}

#s--{{ section.id }} .showMore .button:hover {
  background-color: #e25b7b;
}

/* Responsive Grid Tiers: 4 then 3 then 2 then 1 (matching collection page product-list.liquid) */

/* Tier 1: 4 cards per row on Large Desktop (> 1100px) */
@media (min-width: 1101px) {
  #s--{{ section.id }} .card--holder {
    flex: 0 0 25%;
    max-width: 25%;
    flex-basis: 25%;
  }
}

/* Tier 2: 3 cards per row on Medium/Small Desktop & Landscape Tablet (769px - 1100px) */
@media (min-width: 769px) and (max-width: 1100px) {
  #s--{{ section.id }} .tab__container {
    padding: 30px 20px 70px;
  }
  #s--{{ section.id }} .card--holder {
    flex: 0 0 33.333333%;
    max-width: 33.333333%;
    flex-basis: 33.333333%;
  }
  #s--{{ section.id }} .card--default .card__review-stars {
    font-size: 12px;
    letter-spacing: 0.5px;
  }
  #s--{{ section.id }} .card--default .card__review-score,
  #s--{{ section.id }} .card--default .card__review-count {
    font-size: 12px;
  }
}

/* General below-tablet / mobile settings (<= 768px) */
@media (max-width: 768px) {
  #s--{{ section.id }} .section__heading--heading h2,
  #s--{{ section.id }} .section__heading h2 {
    font-size: 24px;
  }

  #s--{{ section.id }} .tab__holder {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    margin: 0 auto 24px auto;
    padding: 0;
    overflow: visible;
  }

  #s--{{ section.id }} .cm-tabs-pill-nav {
    display: none;
  }

  #s--{{ section.id }} .cm-tabs-mobile-select-wrap {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    box-sizing: border-box;
    padding: 0 12px;
  }

  #s--{{ section.id }} .card--default .card__brand {
    font-size: 14px;
  }

  #s--{{ section.id }} .card--default .card__title {
    font-size: 13px;
  }

  #s--{{ section.id }} .card--default .card__price {
    font-size: 14px;
  }
}

/* Tier 3: 2 cards per row on Portrait Tablet & Large Mobile (551px - 768px) */
@media (min-width: 551px) and (max-width: 768px) {
  #s--{{ section.id }} .tab__container {
    padding: 20px 16px 60px;
  }
  #s--{{ section.id }} .card--holder {
    flex: 0 0 50%;
    max-width: 50%;
    flex-basis: 50%;
    padding: 0 10px 30px;
  }
  #s--{{ section.id }} .card--default .card__img-wrap,
  #s--{{ section.id }} .card--default .card__img-link,
  #s--{{ section.id }} .card--default img {
    border-radius: 20px;
  }
  #s--{{ section.id }} .card--default .card__review-stars {
    font-size: 11px;
    letter-spacing: 0;
  }
  #s--{{ section.id }} .card--default .card__review-score,
  #s--{{ section.id }} .card--default .card__review-count {
    font-size: 12px;
  }
}

/* Tier 4: 1 card per row on Mobile below 550px (<= 550px) */
@media (max-width: 550px) {
  #s--{{ section.id }} .tab__container {
    padding: 10px 14px 40px;
  }
  #s--{{ section.id }} .card--holder {
    flex: 0 0 100%;
    max-width: 100%;
    flex-basis: 100%;
    padding: 0 12px 28px;
  }
  #s--{{ section.id }} .card--default {
    max-width: 440px;
    margin-left: auto;
    margin-right: auto;
  }
  #s--{{ section.id }} .card--default .card__img-wrap,
  #s--{{ section.id }} .card--default .card__img-link,
  #s--{{ section.id }} .card--default img {
    border-radius: 20px;
  }
}

#colorcode{}
</style>

{% assign mobile = settings.cardMobile | default: '6' %}
{% assign desktop = settings.cardDesktop | default: '3' %}
{% assign customID = section.settings.custom_id %}

<div
id="s--{{section.id}}"
{% unless section.settings.backgroundImage == nil -%}{% render 'background', image: section.settings.backgroundImage %}{%- endunless %}
class="{% render 'common-class', section: section, class: 'row', bg: true %}">
  {% if section.settings.overlayOpacity > 0 %}
    <div
    class="overlay"
    style="opacity: {{section.settings.overlayOpacity | times: 0.01}}; background-color: {{section.settings.overlayColor}};">
    </div>
  {% endif %}
  <div 
    id="{{customID}}"
  class="unflex s__content layout__content tab__container">
    {% render 'block__general--heading' with section as section %}
    <div class="tab__holder center">
      <div class="cm-tabs-pill-nav">
        {%- for block in section.blocks %}
            {% assign collection = collections[block.settings.collection] %}
            <span class="cm-tab-item {% if forloop.first %}tab--active{% endif %}"
                  data-target="featured--{{-block.id}}"
                  onclick="BoosterTheme.ELEMENTS.toggleTab(this, 'featured--{{-block.id}}'); var s = this.closest('.tab__container').querySelector('.cm-tabs-select'); if(s) s.value = 'featured--{{-block.id}}';">
              {% unless block.settings.title == blank %}{{block.settings.title}}{% else %}{{collection.title}}{% endunless %}
            </span>
        {% else %}
            {% for i in (1..3) %}
                <span class="cm-tab-item {% if forloop.first %}tab--active{% endif %}"
                      data-target="featured--{{-section.id}}-{{-i}}"
                      onclick="BoosterTheme.ELEMENTS.toggleTab(this, 'featured--{{-section.id}}-{{-i}}'); var s = this.closest('.tab__container').querySelector('.cm-tabs-select'); if(s) s.value = 'featured--{{-section.id}}-{{-i}}';">
                  Tab {{i}}
                </span>
            {% endfor %}
        {% endfor %}
      </div>

      <div class="cm-tabs-mobile-select-wrap">
        <div class="cm-tabs-select-box">
          <select class="cm-tabs-select" aria-label="Select Category" onchange="window.cmHandleTabSelect && window.cmHandleTabSelect(this)">
            {%- for block in section.blocks %}
              {% assign collection = collections[block.settings.collection] %}
              <option value="featured--{{-block.id}}" {% if forloop.first %}selected{% endif %}>
                {% unless block.settings.title == blank %}{{block.settings.title}}{% else %}{{collection.title}}{% endunless %}
              </option>
            {% else %}
              {% for i in (1..3) %}
                <option value="featured--{{-section.id}}-{{-i}}" {% if forloop.first %}selected{% endif %}>
                  Tab {{i}}
                </option>
              {% endfor %}
            {% endfor %}
          </select>
          <span class="cm-tabs-select-arrow" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M6 9L12 15L18 9" stroke="#F07290" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </div>
      </div>
    </div>
    {%- for block in section.blocks %}
        {% unless block.settings.collection == blank %}
        <div id="featured--{{-block.id}}" class="row featured-tabs__content {% if forloop.first %}tab--show{% endif %}">
            {% assign collection = collections[block.settings.collection] %}
            {% assign iter = collection.products.size | at_most: section.settings.prdtCount | minus: 1 %}
            {% for i in (0..iter) %}
            {% assign prdt = collection.products[i] %}
            <div class="col-{{-mobile}} col-md-{{-desktop}} card--holder">
                {% render 'product-card-default' with prdt as product %}
            </div>
            {% endfor %}
            {% if section.settings.showMore %}
                <div class="col-12 showMore {{section.settings.showMoreAlignment}}">
                  {% unless section.settings.showMoreText == empty %}
                    {% assign smt = section.settings.showMoreText %}
                  {% else %}
                    {% assign smt = 'general.buttons.show_more' | t %}
                  {% endunless %}
                    {% render 'button', type: 'primary', text: smt, url: collection.url %}
                </div>
            {% endif %}
        </div>
        {% endunless %}
    {% else %}
        {% for i in (1..3) %}
            <div id="featured--{{-section.id}}-{{-i}}" class="row featured-tabs__content {% if forloop.first %}tab--show{% endif %}">
                {% for i in (1..4) %}
                <div class="col-{{-mobile}} col-md-{{-desktop}} card--holder">
                    {% render 'product-card-fake' with i as i %}
                </div>
                {% endfor %}
            </div>
        {% endfor %}
    {% endfor %}
  </div>
</div>

<script>
  if (typeof window.cmHandleTabSelect === 'undefined') {
    window.cmHandleTabSelect = function(select) {
      var targetId = select.value;
      var container = select.closest('.tab__container');
      if (!container) return;

      var currentShow = container.querySelector('.tab--show');
      if (currentShow) currentShow.classList.remove('tab--show');
      var targetContent = container.querySelector('#' + targetId);
      if (targetContent) targetContent.classList.add('tab--show');

      var currentActive = container.querySelector('.cm-tab-item.tab--active');
      if (currentActive) currentActive.classList.remove('tab--active');
      var matchingPill = container.querySelector('.cm-tab-item[data-target="' + targetId + '"]');
      if (matchingPill) matchingPill.classList.add('tab--active');
    };
  }
</script>

{% schema %}
{
    "name": {
        "en": "Featured collections tabs"
    },
    "settings": [
        {
      "type": "header",
      "content": "Help"
    },
    {
      "type": "paragraph",
      "content": "[Click here to follow an interactive Tutorial](https://vimeo.com/458157822)"
    },
    {
      "type": "header",
      "content": "Section ID"
    },
    {
        "type": "text",
        "id": "custom_id",
        "label": "Add custom section ID"
    },
        {
        "type": "header",
        "content": "Section layout"
    },
    {
      "type": "radio",
      "id": "displayFor",
      "label": "Show this section on",
      "options": [
        {"value": "display--both", "label": "All devices"},
        {"value": "hide-desktop", "label": "Mobile only"},
        {"value": "hide-mobile", "label": "Desktop only"}
      ],
      "default": "display--both"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Section layout",
      "options": [
        {"value": "default", "label": "Global default"},
        {"value": "boxed", "label": "Boxed"},
        {"value": "stretchBg", "label": "Full width background"},
        {"value": "stretchContent", "label": "Full width"}
      ],
      "default": "default"
    },
    {
      "type": "checkbox",
      "id": "nomargin",
      "default": false,
      "label": "Remove section's bottom margin"
    },
    {
      "type": "textarea",
      "id": "scopedCSS",
      "label": "Section-scoped CSS",
      "info": "Rules beginning with ##scoped will be scoped to this section. (Example: ##scoped h1 {color: blue})"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Minimum height",
      "default": 0,
      "min": 0,
      "max": 800,
      "step": 10,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Section padding",
      "default": 0,
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px"
    },
        {
    "type": "header",
    "content": "Section background"
