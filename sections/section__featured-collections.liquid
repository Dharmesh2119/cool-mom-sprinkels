                      {%- if b_prod.featured_image != blank -%}
                        <img src="{{ b_prod.featured_image | image_url: width: 600 }}" alt="{{ b_prod.title | escape }}" class="cm-product-card__img" loading="lazy" width="300" height="300">
                      {%- else -%}
                        <img src="{{ 'category-cake.jpg' | asset_url }}" alt="{{ b_prod.title | escape }}" class="cm-product-card__img" loading="lazy" width="300" height="300">
                      {%- endif -%}
                    </a>
                    {%- assign first_variant = b_prod.selected_or_first_available_variant | default: b_prod.variants.first -%}
                    {% if first_variant.available %}
                      <button type="button" class="cm-product-card__atc"
                        data-buy-button="{{ b_prod.id }}"
                        data-original-text="ADD TO CART"
                        onclick="event.preventDefault(); event.stopPropagation(); BoosterTheme.cart.addToCartJSON(event, {items: [{id: {{ first_variant.id }}, quantity: 1}]});"
                        aria-label="Add {{ b_prod.title | escape }} to cart">
                        <svg class="cm-product-card__atc-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                          <path fill-rule="evenodd" clip-rule="evenodd" d="M5 4C4.44772 4 4 4.44772 4 5L2.2 19C2.1 19.8 2.5 20.6 3.1 21.1C3.7 21.7 4.5 22 5.3 22H18.7C19.5 22 20.3 21.7 20.9 21.1C21.5 20.6 21.9 19.8 21.8 19L20 5C20 4.44772 19.5523 4 19 4H5ZM8.5 7C8.5 6.44772 8.94772 6 9.5 6C10.0523 6 10.5 6.44772 10.5 7C10.5 7.82843 11.1716 8.5 12 8.5C12.8284 8.5 13.5 7.82843 13.5 7C13.5 6.44772 13.9477 6 14.5 6C15.0523 6 15.5 6.44772 15.5 7C15.5 10.933 13.933 10.5 12 10.5C10.067 10.5 8.5 8.933 8.5 7Z" fill="#ffffff"/>
                        </svg>
                        <span data-button-text>ADD TO CART</span>
                      </button>
                    {% else %}
                      <button type="button" class="cm-product-card__atc" disabled aria-label="Sold out" data-original-text="SOLD OUT">
                        <span data-button-text>SOLD OUT</span>
                      </button>
                    {% endif %}
                  </div>
                  <a href="{{ b_prod.url }}" class="cm-product-card__info">
                    <p class="cm-product-card__vendor">{{ b_prod.vendor | default: 'Cool mom sprinkles' }}</p>
                    <h3 class="cm-product-card__title">{{ b_prod.title }}</h3>
                    {% render 'cm-product-rating', prod: b_prod, format: 'card_grid' %}
                    <p class="cm-product-card__price jsPrice">From {{ b_prod.price | money }}</p>
                  </a>
                </div>
                {%- assign products_rendered = products_rendered | plus: 1 -%}
              {%- elsif b_coll.image != blank -%}
                <div class="cm-product-card" {{ block.shopify_attributes }}>
                  <div class="cm-product-card__img-wrap">
                    <a href="{{ b_coll.url }}" class="cm-product-card__img-link" aria-label="{{ b_coll.title | escape }}">
                      <img src="{{ b_coll.image | image_url: width: 600 }}" alt="{{ b_coll.title | escape }}" class="cm-product-card__img" loading="lazy" width="300" height="300">
                    </a>
                    <a href="{{ b_coll.url }}" class="cm-product-card__atc" aria-label="View {{ b_coll.title | escape }}">
                      <svg class="cm-product-card__atc-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M5 4C4.44772 4 4 4.44772 4 5L2.2 19C2.1 19.8 2.5 20.6 3.1 21.1C3.7 21.7 4.5 22 5.3 22H18.7C19.5 22 20.3 21.7 20.9 21.1C21.5 20.6 21.9 19.8 21.8 19L20 5C20 4.44772 19.5523 4 19 4H5ZM8.5 7C8.5 6.44772 8.94772 6 9.5 6C10.0523 6 10.5 6.44772 10.5 7C10.5 7.82843 11.1716 8.5 12 8.5C12.8284 8.5 13.5 7.82843 13.5 7C13.5 6.44772 13.9477 6 14.5 6C15.0523 6 15.5 6.44772 15.5 7C15.5 10.933 13.933 10.5 12 10.5C10.067 10.5 8.5 8.933 8.5 7Z" fill="#ffffff"/>
                      </svg>
                      <span>ADD TO CART</span>
                    </a>
                  </div>
                  <a href="{{ b_coll.url }}" class="cm-product-card__info">
                    <p class="cm-product-card__vendor">Cool mom sprinkles</p>
                    <h3 class="cm-product-card__title">{{ b_coll.title }}</h3>
                    {% render 'cm-product-rating', prod: b_coll.products.first, format: 'card_grid' %}
                    <p class="cm-product-card__price jsPrice">From {{ b_coll.products.first.price | default: 70000 | money }}</p>
                  </a>
                </div>
                {%- assign products_rendered = products_rendered | plus: 1 -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        {%- if products_rendered == 0 -%}
          {%- for product in collections['all'].products limit: 4 -%}
            <div class="cm-product-card">
              <div class="cm-product-card__img-wrap">
                <a href="{{ product.url }}" class="cm-product-card__img-link" aria-label="{{ product.title | escape }}">
                  {%- if product.featured_image != blank -%}
                    <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" class="cm-product-card__img" loading="lazy" width="300" height="300">
                  {%- else -%}
                    <img src="{{ 'category-cake.jpg' | asset_url }}" alt="{{ product.title | escape }}" class="cm-product-card__img" loading="lazy" width="300" height="300">
                  {%- endif -%}
                </a>
                {%- assign first_variant = product.selected_or_first_available_variant | default: product.variants.first -%}
                {% if first_variant.available %}
                  <button type="button" class="cm-product-card__atc"
                    data-buy-button="{{ product.id }}"
                    data-original-text="ADD TO CART"
                    onclick="event.preventDefault(); event.stopPropagation(); BoosterTheme.cart.addToCartJSON(event, {items: [{id: {{ first_variant.id }}, quantity: 1}]});"
                    aria-label="Add {{ product.title | escape }} to cart">
                    <svg class="cm-product-card__atc-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path fill-rule="evenodd" clip-rule="evenodd" d="M5 4C4.44772 4 4 4.44772 4 5L2.2 19C2.1 19.8 2.5 20.6 3.1 21.1C3.7 21.7 4.5 22 5.3 22H18.7C19.5 22 20.3 21.7 20.9 21.1C21.5 20.6 21.9 19.8 21.8 19L20 5C20 4.44772 19.5523 4 19 4H5ZM8.5 7C8.5 6.44772 8.94772 6 9.5 6C10.0523 6 10.5 6.44772 10.5 7C10.5 7.82843 11.1716 8.5 12 8.5C12.8284 8.5 13.5 7.82843 13.5 7C13.5 6.44772 13.9477 6 14.5 6C15.0523 6 15.5 6.44772 15.5 7C15.5 10.933 13.933 10.5 12 10.5C10.067 10.5 8.5 8.933 8.5 7Z" fill="#ffffff"/>
                    </svg>
                    <span data-button-text>ADD TO CART</span>
                  </button>
                {% else %}
                  <button type="button" class="cm-product-card__atc" disabled aria-label="Sold out" data-original-text="SOLD OUT">
                    <span data-button-text>SOLD OUT</span>
                  </button>
                {% endif %}
              </div>
              <a href="{{ product.url }}" class="cm-product-card__info">
                <p class="cm-product-card__vendor">{{ product.vendor | default: 'Cool mom sprinkles' }}</p>
                <h3 class="cm-product-card__title">{{ product.title }}</h3>
                {% render 'cm-product-rating', prod: product, format: 'card_grid' %}
                <p class="cm-product-card__price jsPrice">From {{ product.price | money }}</p>
              </a>
            </div>
            {%- assign products_rendered = products_rendered | plus: 1 -%}
          {%- endfor -%}
        {%- endif -%}

        {%- if products_rendered < 4 -%}
          {%- assign needed = 4 | minus: products_rendered -%}
          {%- for i in (1..needed) -%}
            <div class="cm-product-card">
              <div class="cm-product-card__img-wrap">
                <a href="/collections/all" class="cm-product-card__img-link" aria-label="Mickey mouse sprinkles mix">
                  <img src="{{ 'category-cake.jpg' | asset_url }}" alt="Mickey mouse sprinkles mix" class="cm-product-card__img" loading="lazy" width="300" height="300">
                </a>
                <a href="/collections/all" class="cm-product-card__atc" aria-label="Add to cart">
                  <svg class="cm-product-card__atc-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M5 4C4.44772 4 4 4.44772 4 5L2.2 19C2.1 19.8 2.5 20.6 3.1 21.1C3.7 21.7 4.5 22 5.3 22H18.7C19.5 22 20.3 21.7 20.9 21.1C21.5 20.6 21.9 19.8 21.8 19L20 5C20 4.44772 19.5523 4 19 4H5ZM8.5 7C8.5 6.44772 8.94772 6 9.5 6C10.0523 6 10.5 6.44772 10.5 7C10.5 7.82843 11.1716 8.5 12 8.5C12.8284 8.5 13.5 7.82843 13.5 7C13.5 6.44772 13.9477 6 14.5 6C15.0523 6 15.5 6.44772 15.5 7C15.5 10.933 13.933 10.5 12 10.5C10.067 10.5 8.5 8.933 8.5 7Z" fill="#ffffff"/>
                  </svg>
                  <span>ADD TO CART</span>
                </a>
              </div>
              <a href="/collections/all" class="cm-product-card__info">
                <p class="cm-product-card__vendor">Cool mom sprinkles</p>
                <h3 class="cm-product-card__title">Mickey mouse sprinkles mix</h3>
                {% render 'cm-product-rating', prod: nil, format: 'card_grid' %}
                <p class="cm-product-card__price jsPrice">From {{ 70000 | money }}</p>
              </a>
            </div>
          {%- endfor -%}
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Grid",
  "settings": [
    {
      "type": "select",
      "id": "content_type",
      "label": "Content Type",
      "options": [
        {
          "value": "product",
          "label": "Products"
        },
        {
          "value": "recipe",
          "label": "Recipes"
        }
      ],
      "default": "product"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Featured collection (Product mode)"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog for recipes (optional)"
    },
    {
      "type": "color",
      "id": "backgroundColor",
      "label": "Background color",
      "default": "#FAF0F2"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Eyebrow / Subheading",
      "default": "THE CROWD-PLEASERS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sprinkle bestsellers"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "showMore",
      "label": "Enable 'View all' link",
      "default": true
    },
    {
      "type": "text",
      "id": "showMoreText",
      "label": "View all text",
      "default": "VIEW ALL PRODUCTS"
    },
    {
      "type": "url",
      "id": "showMoreUrl",
      "label": "View all link"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection (Product Mode)",
      "settings": [
        {
          "id": "collection",
          "label": "Collection",
          "type": "collection"
        }
      ]
    },
    {
      "type": "recipe",
      "name": "Recipe Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Recipe Image"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "External Image URL (optional)"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag / Category",
          "default": "PARTY FAVORITE"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Recipe Title",
          "default": "Easy confetti cupcakes with buttercream"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link Text",
          "default": "READ RECIPES"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Recipe URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Collections",
      "category": "Products",
      "settings": {
        "content_type": "product",
        "backgroundColor": "#FAF0F2",
        "subheading": "THE CROWD-PLEASERS",
        "heading": "Sprinkle bestsellers",
        "showMore": true,
        "showMoreText": "VIEW ALL PRODUCTS"
      }
    },
    {
      "name": "Recipes & Inspiration",
      "category": "Blog",
      "settings": {
        "content_type": "recipe",
        "backgroundColor": "#FAF0F2",
        "subheading": "RECIPES & INSPIRATION",
        "heading": "Bake something simple. Make it look special.",
        "showMore": true,
        "showMoreText": "VIEW ALL RECIPES",
        "showMoreUrl": "/blogs/recipes"
      },
      "blocks": [
        {
          "type": "recipe",
          "settings": {
            "tag": "PARTY FAVORITE",
            "title": "Easy confetti cupcakes with buttercream",
            "link_text": "READ RECIPES",
            "link_url": "/blogs/recipes"
          }
        },
        {
          "type": "recipe",
          "settings": {
            "tag": "15 MINUTES",
            "title": "Sprinkle-dipped sugar cookies",
            "link_text": "READ RECIPES",
            "link_url": "/blogs/recipes"
          }
        },
        {
          "type": "recipe",
          "settings": {
            "tag": "BIRTHDAY",
            "title": "One-bowl birthday cake",
            "link_text": "READ RECIPES",
            "link_url": "/blogs/recipes"
          }
        },
        {
          "type": "recipe",
          "settings": {
            "tag": "NO STRESS",
            "title": "Chocolate cake pops",
            "link_text": "READ RECIPES",
            "link_url": "/blogs/recipes"
          }
        }
      ]
    }
  ]
}
{% endschema %}