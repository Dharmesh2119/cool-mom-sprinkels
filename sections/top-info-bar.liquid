{% unless section.settings.enabled == false and section.settings.enabledMobile == false %}

{% if section.settings.bar_mode == 'standard' %}
  {% capture layoutConfig %}{% render 'common-layout' with section as section %}{% endcapture %}

  <div class="layout__{{-layoutConfig}}
  {% unless section.settings.enabledMobile%}hide-mobile{%endunless%} {% unless section.settings.enabled%}hide-desktop{%endunless%}
  {% unless section.settings.colorCombo == 'customCombo' %}{{ section.settings.colorCombo}}{% endunless %}
  colorCombo
  {{section.settings.fontSize}} info-bar" 
  style="{% if section.settings.colorCombo == 'customCombo' %}background-color: {{section.settings.customFillColor}}; color: {{section.settings.customContentColor}};{% endif %} padding-top: 2px; padding-bottom: 2px;"
  >
    <div class="inherit middle row layout__content">
    {% if section.blocks.size > 0 %}
    {%- for block in section.blocks -%}
      <div class="{%- unless block.settings.enabledMobile%}hide-mobile{%endunless%} {% unless block.settings.enabled%}hide-desktop{%endunless%} 
      col-12 col-md middle center 
      block--{{block.type}}
      {% if forloop.length > 1 and block.settings.align == 'auto' %}
      {% if forloop.first %}
      start-md
      {% elsif forloop.last %}
      end-md
      {% endif %}
      {% else %}
      {{block.settings.align}}-md
      {% endif %}"
      {% unless block.type == 'barTextMarquee' %}
      style="flex-wrap: wrap; line-height: {{section.settings.height}}px; {% unless block.type == "minicart" %}overflow: hidden;{% else %}overflow: visible;{% endunless %} min-height: {{section.settings.height}}px;"
      {% else %}
      style="height: {{section.settings.height}}px; line-height: {{section.settings.height}}px; overflow: hidden;"
      {% endunless -%}>
        {% render 'get-block', block: block, section: section %}
        </div>
    {%- endfor -%}
    {% else %}
    <div class="col-12" style="height: {{section.settings.height}}px; line-height: {{section.settings.height}}px; overflow: hidden;">
    </div>
    {% endif %}
    </div>
  </div>

{% else %}
  {%- comment -%} Redesign: Continuous Animated Announcement Marquee (Figma) {%- endcomment -%}
  {%- assign bar_bg = section.settings.bg_color | default: section.settings.customFillColor -%}
  {%- if bar_bg == blank or bar_bg contains 'rgba(0,0,0,0)' -%}{%- assign bar_bg = '#F07290' -%}{%- endif -%}
  
  {%- assign bar_text_color = section.settings.text_color | default: section.settings.customContentColor -%}
  {%- if bar_text_color == blank or bar_text_color contains 'rgba(0,0,0,0)' -%}{%- assign bar_text_color = '#ffffff' -%}{%- endif -%}

  {%- assign bar_star_color = section.settings.star_color | default: bar_text_color -%}
  {%- if bar_star_color == blank or bar_star_color contains 'rgba(0,0,0,0)' -%}{%- assign bar_star_color = '#ffffff' -%}{%- endif -%}

  {%- assign bar_height = section.settings.bar_height | default: 44 -%}
  {%- assign anim_speed = section.settings.speed | default: 50 -%}
  {%- assign anim_direction = section.settings.direction | default: 'rtl' -%}
  {%- assign star_gap = section.settings.star_gap | default: 104 -%}

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

    .top-bar-marquee-wrapper--{{ section.id }} {
      width: 100%;
      overflow: hidden;
      background-color: {{ bar_bg }};
      color: {{ bar_text_color }};
      height: {{ bar_height }}px;
      display: flex;
      align-items: center;
      position: relative;
      z-index: 20;
      line-height: 1;
      border: 0;
      margin: 0;
      padding: 0;
    }

    .top-bar-marquee--{{ section.id }} {
      display: flex;
      width: 100%;
      overflow: hidden;
      user-select: none;
    }

    .top-bar-marquee--{{ section.id }} .top-bar-marquee__track {
      display: flex;
      flex-shrink: 0;
      align-items: center;
      white-space: nowrap;
      will-change: transform;
      animation: topBarMarqueeAnim_{{ section.id }} {{ anim_speed }}s linear infinite;
    }

    {% if anim_direction == 'ltr' %}
      @keyframes topBarMarqueeAnim_{{ section.id }} {
        0% {
          transform: translate3d(-100%, 0, 0);
        }
        100% {
          transform: translate3d(0, 0, 0);
        }
      }
    {% else %}
      @keyframes topBarMarqueeAnim_{{ section.id }} {
        0% {
          transform: translate3d(0, 0, 0);
        }
        100% {
          transform: translate3d(-100%, 0, 0);
        }
      }
    {% endif %}

    {% if section.settings.pause_on_hover %}
      .top-bar-marquee--{{ section.id }}:hover .top-bar-marquee__track {
        animation-play-state: paused;
      }
    {% endif %}

    .top-bar-marquee--{{ section.id }} .top-bar-marquee__item {
      display: inline-flex;
      align-items: center;
      text-decoration: none;
      color: inherit;
    }

    .top-bar-marquee--{{ section.id }} .top-bar-marquee__text {
      display: inline-block;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      font-size: {{ section.settings.font_size | default: 14 }}px;
      font-weight: {{ section.settings.font_weight | default: 500 }};
      text-transform: {{ section.settings.text_transform | default: 'uppercase' }};
      letter-spacing: {{ section.settings.letter_spacing | default: 0 }}px;
      color: {{ bar_text_color }};
      white-space: nowrap;
      margin: 0;
      padding: 0;
      line-height: 1;
      transition: opacity 0.2s ease;
    }

    a.top-bar-marquee__item:hover .top-bar-marquee__text {
      opacity: 0.85;
      text-decoration: underline;
    }

    .top-bar-marquee--{{ section.id }} .top-bar-marquee__separator {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-left: {{ star_gap }}px;
      margin-right: {{ star_gap }}px;
      color: {{ bar_star_color }};
      line-height: 0;
      flex-shrink: 0;
    }

    .top-bar-marquee--{{ section.id }} .top-bar-marquee__separator svg {
      width: 19px;
      height: 19px;
      display: block;
    }

    @media (max-width: 767px) {
      .top-bar-marquee--{{ section.id }} .top-bar-marquee__separator {
        margin-left: calc({{ star_gap }}px * 0.5);
        margin-right: calc({{ star_gap }}px * 0.5);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .top-bar-marquee--{{ section.id }} .top-bar-marquee__track {
        animation-play-state: paused;
      }
    }

    {% unless section.settings.enabled %}
      @media (min-width: 768px) {
        #shopify-section-{{ section.id }} {
          display: none;
        }
      }
    {% endunless %}

    {% unless section.settings.enabledMobile %}
      @media (max-width: 767px) {
        #shopify-section-{{ section.id }} {
          display: none;
        }
      }
    {% endunless %}
  </style>

  {%- capture star_icon -%}
    <span class="top-bar-marquee__separator" aria-hidden="true">
      <svg width="19" height="19" viewBox="0 0 19 19" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M9.375 0C8.95703 8.61328 8.61328 8.95703 0 9.375C8.61328 9.79297 8.95703 10.1367 9.375 18.75C9.79297 10.1367 10.1367 9.79297 18.75 9.375C10.1367 8.95703 9.79297 8.61328 9.375 0Z" fill="{{ bar_star_color }}"/>
      </svg>
    </span>
  {%- endcapture -%}

  {%- capture marquee_item_list -%}
    {%- assign has_announcements = false -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'announcement' or block.type == 'barTextMarquee' -%}
        {%- assign has_announcements = true -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if has_announcements -%}
      {%- for i in (1..4) -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'announcement' and block.settings.text != blank -%}
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="top-bar-marquee__item" {{ block.shopify_attributes }}>
                <span class="top-bar-marquee__text">{{ block.settings.text }}</span>
                {{ star_icon }}
              </a>
            {%- else -%}
              <span class="top-bar-marquee__item" {{ block.shopify_attributes }}>
                <span class="top-bar-marquee__text">{{ block.settings.text }}</span>
                {{ star_icon }}
              </span>
            {%- endif -%}
          {%- elsif block.type == 'barTextMarquee' and block.settings.messages != blank -%}
            <span class="top-bar-marquee__item" {{ block.shopify_attributes }}>
              <span class="top-bar-marquee__text">{{ block.settings.messages | strip_html }}</span>
              {{ star_icon }}
            </span>
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..4) -%}
        <span class="top-bar-marquee__item">
          <span class="top-bar-marquee__text">TRUSTED BY OVER 50,000 CUSTOMERS</span>
          {{ star_icon }}
        </span>
        <span class="top-bar-marquee__item">
          <span class="top-bar-marquee__text">FAMILY OWNED &amp; OPERATED</span>
          {{ star_icon }}
        </span>
        <span class="top-bar-marquee__item">
          <span class="top-bar-marquee__text">FREE SHIPPING ORDERS $100+</span>
          {{ star_icon }}
        </span>
      {%- endfor -%}
    {%- endif -%}
  {%- endcapture -%}

  <div class="top-bar-marquee-wrapper top-bar-marquee-wrapper--{{ section.id }} {% unless section.settings.enabledMobile %}hide-mobile{% endunless %} {% unless section.settings.enabled %}hide-desktop{% endunless %}" role="region" aria-label="Announcement Bar">
    <div class="top-bar-marquee top-bar-marquee--{{ section.id }}">
      <div class="top-bar-marquee__track" aria-hidden="false">
        {{ marquee_item_list }}
      </div>
      <div class="top-bar-marquee__track" aria-hidden="true">
        {{ marquee_item_list }}
      </div>
    </div>
  </div>
{% endif %}

{% endunless %}

