{%- if section.settings.layout == 'default' -%}
{%- assign layout = settings.baseLayout -%}
{%- else -%}
{%- assign layout = section.settings.layout -%}
{%- endif -%}

{% assign root_url = routes.root_url %}
{% assign search_url = root_url | append: 'search' %}
{% if root_url != '/' %}
    {% assign search_url = root_url | append: '/search' %}
{% endif %}

<style>
    {% render 'header__common-css', section: section, layout: layout %}

    /* Senior-Architect Clean Header (Zero !important, Seamless Slider Edge, 20px Margins, No Border) */
    :root {
        --cm-header-max-width: 1280px;
        --cm-header-height: 60px;
        --cm-logo-width: 142px;
        --cm-logo-height: 60px;
        --cm-nav-gap: 20px;
        --cm-header-gap: 32px;
        --cm-text-color: #261514;
        --cm-accent-color: #F07290;
    }

    #shopify-section-{{ section.id }} {
        background-color: #ffffff;
        position: relative;
        top: auto;
        z-index: 20;
        margin-top: 20px;
        margin-bottom: 20px;
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
    }

    header.page__header {
        position: relative;
        top: auto;
        border: none;
        border-bottom: none;
        box-shadow: none;
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
    }

    /* Desktop Header (Active >= 768px, Never Hidden, Margin 20px Top/Bottom, No Bottom Border) */
    header.page__header.page__header--desktop {
        background: #ffffff;
        min-height: var(--cm-header-height);
        height: var(--cm-header-height);
        border: none;
        border-bottom: none;
        box-shadow: none;
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
    }

    header.page__header.page__header--desktop .page__header--width {
        max-width: var(--cm-header-max-width);
        width: 100%;
        height: var(--cm-header-height);
        margin: 0 auto;
        padding: 0 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--cm-header-gap);
        position: relative;
        box-sizing: border-box;
    }

    header.page__header.page__header--desktop .header__logo.header__element--width {
        width: var(--cm-logo-width);
        max-width: var(--cm-logo-width);
        height: var(--cm-logo-height);
        flex: 0 0 var(--cm-logo-width);
        display: flex;
        align-items: center;
        margin: 0;
        padding: 0;
    }

    header.page__header.page__header--desktop .header__logo a.logo-img,
    header.page__header.page__header--desktop .header__logo img {
        width: var(--cm-logo-width);
        height: var(--cm-logo-height);
        max-height: var(--cm-logo-height);
        object-fit: contain;
        display: block;
    }

    /* Nav Wrapper with Dropdowns */
    .header__nav-wrapper {
        display: flex;
        align-items: center;
        position: static;
        flex: 1 1 auto;
        min-width: 0;
        width: auto;
        overflow: visible;
    }

    button.nav-scroll-btn,
    .header__nav-wrapper .nav-scroll-btn {
        display: none;
    }

    header.page__header.page__header--desktop nav.main__navigation {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        flex: 1 1 auto;
        min-width: 0;
        width: auto;
        margin: 0;
        padding: 0;
        overflow: visible;
        position: static;
    }

    header.page__header.page__header--desktop nav.main__navigation > .nav__link__holder {
        display: inline-flex;
        align-items: center;
        height: var(--cm-header-height);
        margin: 0;
        padding: 0;
        position: relative;
    }

    header.page__header.page__header--desktop nav.main__navigation > .nav__link__holder.nav__link__holder--mega-wrap {
        position: static;
    }

    header.page__header.page__header--desktop nav.main__navigation > .nav__link__holder > .nav__link {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        font-size: 14px;
        font-weight: 500;
        color: var(--cm-text-color);
        letter-spacing: 0px;
        padding: 8px 16px;
        border-radius: 8px;
        margin: 0;
        width: auto;
        min-height: auto;
        text-transform: uppercase;
        height: auto;
        display: inline-flex;
        align-items: center;
        white-space: nowrap;
        background: transparent;
        transition: background-color 0.15s ease, color 0.15s ease;
        text-decoration: none;
    }

    header.page__header.page__header--desktop nav.main__navigation > .nav__link__holder:hover > .nav__link,
    header.page__header.page__header--desktop nav.main__navigation > .nav__link__holder.nav__link--active > .nav__link {
        background-color: #FAF0F2;
        color: #F07290;
    }

    header.page__header.page__header--desktop nav.main__navigation .nav__link--fill::before {
        display: none;
    }

    /* Submenus: Base Dropdown Styles & Hover Bridge */
    .cm-nav-submenu {
        position: absolute;
        top: 100%;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        display: none;
        background: #FFFFFF;
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.08);
        border: 1px solid #ECE7E6;
        transition: opacity 0.2s ease, visibility 0.2s ease, transform 0.2s ease;
        transform: translateY(6px);
        z-index: 100;
        box-sizing: border-box;
    }

    .cm-nav-submenu::before {
        content: '';
        position: absolute;
        top: -16px;
        left: 0;
        right: 0;
        height: 16px;
        background: transparent;
    }

    header.page__header.page__header--desktop nav.main__navigation > .nav__link__holder:hover > .cm-nav-submenu,
    header.page__header.page__header--desktop nav.main__navigation > .nav__link__holder:focus-within > .cm-nav-submenu {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transform: translateY(0);
        display: block;
    }

    /* 1. Featured Mega Menu */
    .cm-megamenu-featured {
        left: 24px;
        right: 24px;
        width: calc(100% - 48px);
        max-width: 1240px;
        margin: 0 auto;
        border-radius: 0 0 20px 20px;
        padding: 24px 28px 28px;
    }

    .cm-featured-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
        width: 100%;
        box-sizing: border-box;
    }

    .cm-featured-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-decoration: none;
        width: 100%;
        box-sizing: border-box;
    }

    .cm-featured-img-wrap {
        width: 100%;
        height: 300px;
        border-radius: 16px;
        overflow: hidden;
        background-color: #f7f7f7;
        position: relative;
        box-sizing: border-box;
    }

    .cm-featured-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.35s ease;
    }

    .cm-featured-card:hover .cm-featured-img {
        transform: scale(1.025);
    }

    .cm-featured-title {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        font-size: 15px;
        font-weight: 600;
        color: #261514;
        margin-top: 14px;
        text-align: center;
        transition: color 0.15s ease;
    }

    .cm-featured-card:hover .cm-featured-title {
        color: #F07290;
    }

    /* 2. Shop Sprinkles By Dropdown */
    .cm-dropdown-sprinkles {
        left: 0;
        width: 370px;
        min-width: 340px;
        max-width: calc(100vw - 32px);
        border-radius: 16px;
        padding: 12px 8px;
    }

    .cm-dropdown-list {
        display: flex;
        flex-direction: column;
        gap: 2px;
        width: 100%;
        box-sizing: border-box;
    }

    .cm-dropdown-item {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 12px 14px;
        border-radius: 12px;
        text-decoration: none;
        transition: background-color 0.15s ease;
        box-sizing: border-box;
    }

    .cm-dropdown-item:hover {
        background-color: #FAF0F2;
    }

    .cm-dropdown-icon {
        width: 22px;
        height: 22px;
        color: #261514;
        flex-shrink: 0;
        margin-top: 2px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: color 0.15s ease;
    }

    .cm-dropdown-icon svg {
        display: block;
    }

    .cm-dropdown-item:hover .cm-dropdown-icon {
        color: #F07290;
    }

    .cm-dropdown-text {
        display: flex;
        flex-direction: column;
        flex: 1 1 auto;
    }

    .cm-dropdown-title {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        font-size: 15px;
        font-weight: 600;
        color: #261514;
        line-height: 1.3;
        transition: color 0.15s ease;
    }

    .cm-dropdown-item:hover .cm-dropdown-title {
        color: #F07290;
    }

    .cm-dropdown-desc {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        font-size: 13px;
        font-weight: 400;
        color: #6F5B58;
        line-height: 1.45;
        margin-top: 2px;
    }

    header.page__header.page__header--desktop .header__utility.header__element--width {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 20px;
        width: auto;
        max-width: none;
        flex: 0 0 auto;
    }

    header.page__header.page__header--desktop .header__utility .search__icon,
    header.page__header.page__header--desktop .header__utility .user__button,
    header.page__header.page__header--desktop .header__utility .minicart__button {
        display: inline-flex;
        align-items: center;
        color: var(--cm-text-color);
        font-size: 20px;
        cursor: pointer;
        margin: 0;
        padding: 0;
        transition: color 0.15s ease-in-out;
    }

    header.page__header.page__header--desktop .header__utility .search__icon {
        order: 1;
    }

    header.page__header.page__header--desktop .header__utility .user__button {
        order: 2;
    }

    header.page__header.page__header--desktop .header__utility .minicart__button {
        order: 3;
    }

    header.page__header.page__header--desktop .header__utility .search__icon:hover,
    header.page__header.page__header--desktop .header__utility .user__button:hover,
    header.page__header.page__header--desktop .header__utility .minicart__button:hover {
        color: var(--cm-accent-color);
    }

    /* Tier 1: Laptop & Small Desktop (1041px - 1240px) */
    @media screen and (min-width: 1041px) and (max-width: 1240px) {
        header.page__header.page__header--desktop .page__header--width {
            padding: 0 20px;
            gap: 16px;
        }

        header.page__header.page__header--desktop .header__logo.header__element--width {
            width: 124px;
            max-width: 124px;
            flex: 0 0 124px;
        }

        header.page__header.page__header--desktop .header__logo a.logo-img,
        header.page__header.page__header--desktop .header__logo img {
            width: 124px;
            height: auto;
            max-height: 52px;
        }

        header.page__header.page__header--desktop nav.main__navigation {
            gap: 8px;
        }

        header.page__header.page__header--desktop nav.main__navigation > .nav__link__holder > .nav__link {
            font-size: 13px;
            padding: 6px 10px;
        }

        header.page__header.page__header--desktop .header__utility.header__element--width {
            gap: 16px;
        }

        .cm-megamenu-featured {
            left: 20px;
            right: 20px;
            width: calc(100% - 40px);
            padding: 20px 24px 24px;
        }

        .cm-featured-img-wrap {
            height: 240px;
        }

        .cm-dropdown-sprinkles {
            width: 340px;
            min-width: 300px;
        }
    }

    /* Tier 2: Standard Tablet Landscape (881px - 1040px) */
    @media screen and (min-width: 881px) and (max-width: 1040px) {
        header.page__header.page__header--desktop .page__header--width {
            padding: 0 14px;
            gap: 12px;
        }

        header.page__header.page__header--desktop .header__logo.header__element--width {
            width: 110px;
            max-width: 110px;
            flex: 0 0 110px;
        }

        header.page__header.page__header--desktop .header__logo a.logo-img,
        header.page__header.page__header--desktop .header__logo img {
            width: 110px;
            height: auto;
            max-height: 46px;
        }

        header.page__header.page__header--desktop nav.main__navigation {
            gap: 6px;
        }

        header.page__header.page__header--desktop nav.main__navigation > .nav__link__holder > .nav__link {
            font-size: 12px;
            padding: 5px 8px;
            letter-spacing: -0.2px;
        }

        header.page__header.page__header--desktop .header__utility.header__element--width {
            gap: 12px;
        }

        header.page__header.page__header--desktop .header__utility .search__icon,
        header.page__header.page__header--desktop .header__utility .user__button,
        header.page__header.page__header--desktop .header__utility .minicart__button {
            font-size: 18px;
        }

        .cm-megamenu-featured {
            left: 14px;
            right: 14px;
            width: calc(100% - 28px);
            padding: 18px 20px 20px;
        }

        .cm-featured-img-wrap {
            height: 220px;
        }

        .cm-dropdown-sprinkles {
            width: 320px;
            min-width: 280px;
            max-width: calc(100vw - 28px);
        }
    }

    /* Tier 3: Compact Tablet Portrait (768px - 880px, perfectly optimized for 822px) */
    @media screen and (min-width: 768px) and (max-width: 880px) {
        header.page__header.page__header--desktop .page__header--width {
            padding: 0 10px;
            gap: 10px;
        }

        header.page__header.page__header--desktop .header__logo.header__element--width {
            width: 98px;
            max-width: 98px;
            flex: 0 0 98px;
        }

        header.page__header.page__header--desktop .header__logo a.logo-img,
        header.page__header.page__header--desktop .header__logo img {
            width: 98px;
            height: auto;
            max-height: 40px;
        }

        header.page__header.page__header--desktop nav.main__navigation {
            gap: 4px;
        }

        header.page__header.page__header--desktop nav.main__navigation > .nav__link__holder > .nav__link {
            font-size: 11px;
            padding: 4px 5px;
            letter-spacing: -0.3px;
        }

        header.page__header.page__header--desktop .header__utility.header__element--width {
            gap: 10px;
        }

        header.page__header.page__header--desktop .header__utility .search__icon,
        header.page__header.page__header--desktop .header__utility .user__button,
        header.page__header.page__header--desktop .header__utility .minicart__button {
            font-size: 17px;
        }

        .cm-megamenu-featured {
            left: 10px;
            right: 10px;
            width: calc(100% - 20px);
            padding: 16px;
        }

        .cm-featured-img-wrap {
            height: 180px;
        }

        .cm-dropdown-sprinkles {
            width: 290px;
            min-width: 250px;
            max-width: calc(100vw - 20px);
        }
    }

    /* Mobile Header (< 768px) */
    @media screen and (max-width: 767px) {
        #shopify-section-{{ section.id }} {
            margin-top: 10px;
            margin-bottom: 10px;
        }

        header.page__header.page__header--desktop {
            display: none;
        }

        header.page__header.page__header--mobile {
            display: flex;
        }
    }

    @media screen and (min-width: 768px) {
        header.page__header.page__header--desktop {
            display: flex;
        }

        header.page__header.page__header--mobile {
            display: none;
        }
    }

    header.page__header--mobile {
        background-color: #ffffff;
        min-height: var(--cm-header-height);
        height: var(--cm-header-height);
        border: none;
        border-bottom: none;
    }

    header.page__header--mobile .page__header--width {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 16px;
        height: var(--cm-header-height);
        width: 100%;
    }

    header.page__header--mobile .header__logo {
        width: 120px;
        height: var(--cm-header-height);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    header.page__header--mobile .header__logo img {
        width: 120px;
        height: auto;
        max-height: 48px;
        object-fit: contain;
    }

    header.page__header--mobile .mobile-submenu-label {
        font-size: 24px;
        color: #261514;
        cursor: pointer;
        display: flex;
        align-items: center;
    }

    header.page__header--mobile .header__utility {
        display: flex;
        align-items: center;
        gap: 16px;
        color: #261514;
    }
</style>

<div data-search-container class="search__container--abs">
    <div class="search__overlay" onclick="BoosterTheme.ELEMENTS.closeSearch(this)"></div>
    <div class="search__container--wrapper">
        <h4 class="h-reset search__title">{{'general.search.heading' | t}} <span onclick="BoosterTheme.ELEMENTS.closeSearch(this)">{% render 'get-icon', icon: 'close' %}</span></h4>
        <form method="get" action="{{search_url}}">
            <button type="submit" class="search__icon--submit" aria-label="Search">{% render 'get-icon', icon: 'search' %}</button>
            <input autocomplete="off" placeholder="{{'general.search.placeholder' | t }}" name="q" onfocus="BoosterTheme.ELEMENTS.openSearch(this)" type="search" data-search>
        </form>
    </div>
    <div class="search__results search__results--abs" data-search-suggest>
    </div>
</div>

{% comment %} Navigation Menu: Custom Linklist Integration {% endcomment %}
{% assign use_figma_demo_data = section.settings.show_figma_demo_menu %}
{% assign header_links = linklists[section.settings.menuLinks].links %}
{% if header_links == blank or header_links.size == 0 %}
    {% if linklists['cool-mom-sprinkles-main-menu'].links.size > 0 %}
        {% assign header_links = linklists['cool-mom-sprinkles-main-menu'].links %}
    {% elsif linklists['main-menu'].links.size > 0 %}
        {% assign header_links = linklists['main-menu'].links %}
    {% endif %}
{% endif %}

<header class="page__header page__header--desktop {% if template == "index" and section.settings.transparent %}page__header--transparent{% endif %}">
    <div class="page__header--width">
        <div class="header__logo header__element--width">
            {% render 'logo' with section as section %}
        </div>
        <div class="header__nav-wrapper">
            <nav class="main__navigation main__navigation--center main__navigation--{{section.settings.hoverStyle}} font__size--{{-section.settings.fontSize}}" aria-label="Main Navigation">
                {% if use_figma_demo_data %}
                    {% for item in figma_menu_items %}
                        {% assign parts = item | split: "|" %}
                        <span class="nav__link__holder">
                            <a class="nav__link" href="{{ parts[1] }}">{{ parts[0] }}</a>
                        </span>
                    {% endfor %}
                {% else %}
                    {% for link in header_links %}
                        {% if link.links.size > 0 %}{% capture submenu %}{% render 'header--link-submenu' with link as link %}{% endcapture %}{% else %}{% assign submenu = '' %}{% endif %}
                        {% assign link_title_clean = link.title | strip | downcase %}
                        <span class="nav__link__holder {% if link_title_clean == 'featured' %}nav__link__holder--mega-wrap{% endif %} {% if link.active or link.child_active %}nav__link--active{% endif %} {% if submenu contains 'nav__submenu--regular' %}nav__link__holder--regular{% endif %}">
                            <a class="nav__link nav__link--{{section.settings.hoverStyle}}" href="{{link.url}}">{% render 'header--link-tag' with link.title as text %}</a>
                            {{submenu}}
                        </span>
                    {% endfor %}
                {% endif %}
            </nav>
        </div>
        <div class="header__element--width header__utility">
            {% render 'header__general--utility', showCart: section.settings.desktopCart %}
        </div>
    </div>
</header>

<header class="page__header page__header--mobile hide-desktop {% if template == "index" and section.settings.transparent %}page__header--transparent{% endif %}">
    <div class="page__header--width">
        <label class="mobile-submenu-label" for="open-mobile-nav">
            <i class="uil uil-bars"></i>
        </label>
        <div class="header__logo header__element--width">
            {% render 'logo' with section as section %}
        </div>
        <input id="open-mobile-nav" type="checkbox" style="display: none">
        <label for="open-mobile-nav" class="overlay overlay--nav"></label>
        <nav class="mobile__navigation" aria-label="Mobile Navigation">
            {% if use_figma_demo_data %}
                {% for item in figma_menu_items %}
                    {% assign parts = item | split: "|" %}
                    <span class="nav__link__holder">
                        <a class="nav__link" href="{{ parts[1] }}">{{ parts[0] }}</a>
                    </span>
                {% endfor %}
            {% else %}
                {% for link in header_links %}
                    <span class="nav__link__holder">
                        <a class="nav__link {% if link.active or link.child_active %}nav__link--active{% endif %}" href="{{link.url}}">{% render 'header--link-tag' with link.title as text %}</a><!--
                        {% if link.links.size > 0 %}
                            --><input type="checkbox" style="display: none" id="mobile-submenu-{{forloop.index}}"><!--
                            --><label class="mobile__submenu__toggle" for="mobile-submenu-{{forloop.index}}"><i class="uil uil-plus"></i><i class="uil uil-minus"></i></label>
                            {% render 'header--link-submenu--mobile', link: link, ix: forloop.index %}
                        {% else %}
                        -->
                        {% endif %}
                    </span>
                {% endfor %}
            {% endif %}
            <div class="mobile__navigation__footer">
                {% render 'header__mobile--footer' %}
            </div>
        </nav>
        <div class="header__utility">
        {% render 'header__general--utility', mobile: true, showCart: section.settings.mobileCart %}
        </div>
    </div>
</header>

<script>
(()=>{
    const nav = document.querySelector('header.page__header--desktop nav.main__navigation');
    const leftBtn = document.querySelector('.nav-scroll-btn--left');
    const rightBtn = document.querySelector('.nav-scroll-btn--right');
    if(!nav || !leftBtn || !rightBtn) return;
    const checkNavScroll = () => {
        if(nav.scrollWidth > nav.clientWidth + 4) {
            leftBtn.style.display = nav.scrollLeft > 8 ? 'inline-flex' : 'none';
            rightBtn.style.display = (nav.scrollWidth - nav.clientWidth - nav.scrollLeft > 8) ? 'inline-flex' : 'none';
        } else {
            leftBtn.style.display = 'none';
            rightBtn.style.display = 'none';
        }
    };
    nav.addEventListener('scroll', checkNavScroll, { passive: true });
    window.addEventListener('resize', checkNavScroll, { passive: true });
    setTimeout(checkNavScroll, 100);
})();
</script>

{% render 'header__common-js' with section as section %}

{% schema %}
{
  "name": {
    "en": "Header - Default"
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_figma_demo_menu",
      "label": "Show Figma Redesign Navigation Data",
      "info": "Displays the exact 10 navigation links from the Figma redesign mockup ('Home', 'Shop All', 'Shop by holiday', etc.)",
      "default": true
    },
    {
      "type": "header",
      "content": "Help"
    },
    {
      "type": "paragraph",
      "content": "[Click here to follow an interactive Tutorial](https://vimeo.com/458159291)"
    },
