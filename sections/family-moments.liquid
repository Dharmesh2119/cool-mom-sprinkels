      "default": "Rainbow star celebration cake"
    },
    {
      "type": "image_picker",
      "id": "image_thumb_2",
      "label": "Image 2 (Top-Right - 305x260)"
    },
    {
      "type": "text",
      "id": "alt_thumb_2",
      "label": "Alt text 2",
      "default": "Turquoise cupcakes with sprinkles"
    },
    {
      "type": "image_picker",
      "id": "image_thumb_3",
      "label": "Image 3 (Bottom-Left - 305x260)"
    },
    {
      "type": "text",
      "id": "alt_thumb_3",
      "label": "Alt text 3",
      "default": "Warm bakery interior"
    },
    {
      "type": "image_picker",
      "id": "image_thumb_4",
      "label": "Image 4 (Bottom-Right - 305x260)"
    },
    {
      "type": "text",
      "id": "alt_thumb_4",
      "label": "Alt text 4",
      "default": "Strawberry cupcakes with white chocolate drizzle"
    }
  ],
  "presets": [
    {
      "name": "Family Moments",
      "category": "Image",
      "settings": {
        "backgroundColor": "#ffffff",
        "subheading": "MADE FOR REAL FAMILY MOMENTS",
        "heading": "More than a jar of sprinkles."
      }
    }
  ]
