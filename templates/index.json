{"sections":{"0fbdf0a3-17ac-4ab6-8366-83968674ea5c":{"type":"section__cta","settings":{"custom_id":"","displayFor":"display--both","layout":"default","nomargin":true,"scopedCSS":"","height":30,"padding":0,"lineMargin":0,"backgroundColor":"rgba(0,0,0,0)","backgroundImageUrl":"","backgroundPosition":"middle","backgroundFilter":"none","backdropIntensity":50,"parallax":false,"backgroundPattern":false,"overlayOpacity":0,"overlayColor":"#000000","contentColor":"rgba(0,0,0,0)","horizontalAlignment":"center","verticalAlignment":"middle","maxContentWidth":100,"heading":"","headingColor":"rgba(0,0,0,0)","subheading":"","subheadingColor":"rgba(0,0,0,0)","subheadingPosition":"above","headingAlignment":"center"}},"ade00183-4479-4bb5-b59d-f3255a046a7b":{"type":"section__logolist","blocks":{"ed021856-207d-41de-876e-e372c383993a":{"type":"logoListLogo","settings":{"logo":"shopify:\/\/shop_images\/download_1.png","logoLink":"https:\/\/www.amazon.com\/coolmomsprinkles"}},"d4203a0c-0b4e-4886-a86c-e860e5aa9374":{"type":"logoListLogo","settings":{"logo":"shopify:\/\/shop_images\/download_2.png","logoLink":"https:\/\/www.etsy.com\/shop\/CoolMomSprinkles"}}},"block_order":["ed021856-207d-41de-876e-e372c383993a","d4203a0c-0b4e-4886-a86c-e860e5aa9374"],"settings":{"custom_id":"","displayFor":"display--both","layout":"default","nomargin":false,"scopedCSS":"","height":600,"padding":0,"lineMargin":12,"backgroundColor":"rgba(0,0,0,0)","backgroundPosition":"middle","backgroundFilter":"none","backdropIntensity":50,"parallax":false,"backgroundPattern":false,"overlayOpacity":0,"overlayColor":"#000000","horizontalAlignment":"center","verticalAlignment":"middle","heading":"As Seen On","headingColor":"rgba(0,0,0,0)","subheading":"","subheadingColor":"rgba(0,0,0,0)","subheadingPosition":"above","headingAlignment":"center","hover":"opacitybw"}},"d2cf3c0b-ebed-43bf-a37a-55b9af30eac4":{"type":"section__image-text","blocks":{"template--15495804813405__d2cf3c0b-ebed-43bf-a37a-55b9af30eac4-title-1":{"type":"title","settings":{"fullWidth":true,"content":"Hi, I’m Kathy!","textColor":"#f07290","fontFamily":"title","fontSize":"medium"}},"template--15495804813405__d2cf3c0b-ebed-43bf-a37a-55b9af30eac4-richText-1":{"type":"richText","settings":{"fullWidth":true,"maxBWidth":100,"content":"<p>I’ve been creating sprinkle mixes for over 15 years. I’m a regular mom\/grandma who wants to help other regular moms create cute things for their kids — without spending a ton of money. <\/p><p>I started Cool Mom Sprinkles to encourage and uplift you to create cute treats that look fantastic and leave you feeling good. <\/p><p>Every single sprinkle is hand mixed and packaged with love. You can use them to turn ordinary desserts into something special — with confidence and ease.<\/p><p>As moms, we want everything to be perfect for our families — because we love them…<\/p><p>But when you scroll on Pinterest to bake the <em>picture perfect dessert<\/em>, you have to sort through recipes that take too much time and money to recreate — that can sometimes leave you feeling inadequate.<\/p><p>I don’t want anyone to <em>ever<\/em> feel like they can’t make something cute because it’s not insta-worthy, it’s too expensive, or it’s too complicated. That’s why I created a go-to tool and secret weapon for bakers everywhere – Cool Mom Sprinkles. <\/p><p>Here at Cool Mom Sprinkles, our goal is to empower moms and bakers everywhere to be able to whip up something simple and make it wonderful – without spending the whole day in the kitchen.<\/p><p>Because when you can make something special in a matter of minutes, you can spend the rest of the day doing the things that matter the most.<\/p>","detectLists":true,"textColor":"#000000","fontFamily":"base","fontSize":"base"}},"template--15495804813405__d2cf3c0b-ebed-43bf-a37a-55b9af30eac4-button-1":{"type":"button","settings":{"fullWidth":true,"text":"The Full Story","url":"shopify:\/\/pages\/our-story","icon":"","iconPosition":"icon--left","wideButton":false,"