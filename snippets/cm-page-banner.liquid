{% comment %}
  Cool Mom Sprinkles - Unified Inner Page Banner
  Figma specifications:
  - W 1440, H 375 (375px height desktop / 260px mobile)
  - With image: linear-gradient(90deg, #F9DED9 0%, rgba(249, 222, 217, 0.51) 61%, rgba(249, 222, 217, 0) 100%), background-image
  - Without image: linear-gradient(90deg, #F9DED9 0%, rgba(249, 222, 217, 0.51) 50%, rgba(249, 222, 217, 0) 94%), #FFFFFF
  - Breadcrumbs: Centered uppercase bold (HOME / SHOP or HOME / PAGE TITLE)
  - Title: Centered display serif bold 72px (#261514)
{% endcomment %}

{%- if collection.handle == 'all' -%}
  {%- assign banner_title = 'Collections' -%}
{%- else -%}
  {%- assign banner_title = title | default: page_title -%}
{%- endif -%}

{%- assign has_image = false -%}
{%- assign banner_bg_url = '' -%}

{%- if image != blank -%}
  {%- assign has_image = true -%}
  {%- assign banner_bg_url = image -%}
{%- elsif template == 'list-collections' or collection.handle == 'all' -%}
  {%- assign has_image = true -%}
  {%- assign banner_bg_url = 'banner-collections.jpg' | asset_url -%}
{%- elsif template contains 'collection' and collection.image != blank -%}
  {%- assign has_image = true -%}
  {%- assign banner_bg_url = collection.image | img_url: '1600x' -%}
{%- endif -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..900;1,9..144,400..900&family=Inter:wght@400;500;600;700&display=swap');

  #shopify-section-template--28185362759773__banner,
  #shopify-section-template--28185362727005__banner,
  .shopify-section:has(.cm-page-banner),
  div:has(> .cm-page-banner) {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0;
  }

  .cm-page-banner {
    width: 100%;
    min-height: 375px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    text-align: center;
    overflow: hidden;
  }

  .cm-page-banner--has-image {
    background-color: #F9DED9;
    background-image: 
      linear-gradient(90deg, #F9DED9 0%, rgba(249, 222, 217, 0.51) 61%, rgba(249, 222, 217, 0) 100%),
      url('{{ banner_bg_url }}');
    background-size: cover;
    background-position: center right;
    background-repeat: no-repeat;
  }

  .cm-page-banner--no-image {
    background-color: #FFFFFF;
    background-image: linear-gradient(90deg, #F9DED9 0%, rgba(249, 222, 217, 0.51) 50%, rgba(249, 222, 217, 0) 94%);
    background-repeat: no-repeat;
    background-size: 100% 100%;
  }

  .cm-page-banner__inner {
    position: relative;
    z-index: 2;
    max-width: 960px;
    width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .cm-page-banner__breadcrumbs {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #261514;
    margin: 0 0 12px 0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    line-height: 1.4;
  }

  .cm-page-banner__breadcrumb-link {
    color: #261514;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .cm-page-banner__breadcrumb-link:hover {
    opacity: 0.7;
    text-decoration: underline;
  }

  .cm-page-banner__breadcrumb-sep {
    color: #261514;
    opacity: 0.6;
    margin: 0 8px;
    font-weight: 600;
    user-select: none;
  }

  .cm-page-banner__breadcrumb-current {
    color: #261514;
    font-weight: 700;
  }

  .cm-page-banner__title {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 72px;
    font-weight: 700;
    line-height: 1.1;
    color: #261514;
    margin: 0;
    letter-spacing: -0.5px;
    word-break: break-word;
  }

  @media (max-width: 768px) {
    .cm-page-banner {
      min-height: 260px;
      padding: 32px 16px;
    }

    .cm-page-banner--has-image {
      background-position: 75% center;
    }

    .cm-page-banner__breadcrumbs {
      font-size: 13px;
      letter-spacing: 0.8px;
      margin-bottom: 8px;
    }

    .cm-page-banner__breadcrumb-sep {
      margin: 0 6px;
    }

    .cm-page-banner__title {
      font-size: 32px;
    }
  }
</style>

<section class="cm-page-banner {% if has_image %}cm-page-banner--has-image{% else %}cm-page-banner--no-image{% endif %}" role="banner" aria-label="{{ banner_title }}">
  <div class="cm-page-banner__inner">
    <nav class="cm-page-banner__breadcrumbs" aria-label="breadcrumbs">
      <a href="{{ routes.root_url }}" class="cm-page-banner__breadcrumb-link">HOME</a>
      <span class="cm-page-banner__breadcrumb-sep" aria-hidden="true">/</span>

      {%- if template == 'list-collections' or collection.handle == 'all' -%}
        <span class="cm-page-banner__breadcrumb-current">SHOP</span>
      {%- elsif template contains 'collection' -%}
        <a href="/collections" class="cm-page-banner__breadcrumb-link">SHOP</a>
        <span class="cm-page-banner__breadcrumb-sep" aria-hidden="true">/</span>
        <span class="cm-page-banner__breadcrumb-current">{{ banner_title | upcase }}</span>
      {%- elsif template contains 'product' -%}
        {%- if collection.url -%}
          <a href="{{ collection.url }}" class="cm-page-banner__breadcrumb-link">{{ collection.title | upcase }}</a>
          <span class="cm-page-banner__breadcrumb-sep" aria-hidden="true">/</span>
        {%- else -%}
          <a href="/collections" class="cm-page-banner__breadcrumb-link">SHOP</a>
          <span class="cm-page-banner__breadcrumb-sep" aria-hidden="true">/</span>
        {%- endif -%}
        <span class="cm-page-banner__breadcrumb-current">{{ product.title | upcase }}</span>
      {%- elsif template contains 'blog' -%}
        <span class="cm-page-banner__breadcrumb-current">{{ blog.title | upcase }}</span>
      {%- elsif template contains 'article' -%}
        <a href="{{ blog.url }}" class="cm-page-banner__breadcrumb-link">{{ blog.title | upcase }}</a>
        <span class="cm-page-banner__breadcrumb-sep" aria-hidden="true">/</span>
        <span class="cm-page-banner__breadcrumb-current">{{ article.title | upcase }}</span>
      {%- elsif template contains 'cart' -%}
        <span class="cm-page-banner__breadcrumb-current">CART</span>
      {%- elsif template contains 'search' -%}
        <span class="cm-page-banner__breadcrumb-current">SEARCH</span>
      {%- else -%}
        <span class="cm-page-banner__breadcrumb-current">{{ banner_title | upcase }}</span>
      {%- endif -%}
    </nav>

    <h1 class="cm-page-banner__title">{{ banner_title }}</h1>
  </div>
</section>
