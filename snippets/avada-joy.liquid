      cartProducts[productIndex].quantity = {{ item.quantity | json }};
      cartProducts[productIndex].collectionIds = {{ item.product.collections | map: 'id' | json }};
      cartProducts[productIndex].collections = {{ item.product.collections | map: 'title' | json }};
