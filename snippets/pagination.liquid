{% if paginate.pages > 1 %}
<style>
  .cm-pagination-container {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin: 48px auto 60px;
    padding: 0;
  }

  .cm-pagination-item {
    min-width: 28px;
    height: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: #261514;
    text-decoration: none;
    border-radius: 4px;
    box-sizing: border-box;
    transition: all 0.15s ease;
  }

  .cm-pagination-item:hover {
    color: #F07290;
  }

  .cm-pagination-item--current {
    background-color: #F07290;
    color: #FFFFFF;
    font-weight: 700;
    cursor: default;
  }

  .cm-pagination-item--current:hover {
    color: #FFFFFF;
  }

  .cm-pagination-item--dots {
    cursor: default;
    color: #261514;
    letter-spacing: 1px;
  }

  .cm-pagination-item--next {
    background-color: #FCECEF;
    color: #F07290;
    margin-left: 4px;
  }

  .cm-pagination-item--next:hover {
    background-color: #F9DED9;
    color: #F07290;
  }

  .cm-pagination-item--next svg {
    width: 10px;
    height: 10px;
    fill: #F07290;
  }
</style>

<div class="col-12 center middle pagination cm-pagination-container">
  {% for part in paginate.parts %}
    {% if part.is_link %}
      <a onclick="BoosterTheme.ELEMENTS.renderChangePage(event, this, true)" href="{{ part.url }}" class="cm-pagination-item pagination__page">{{ part.title }}</a>
    {% else %}
      {% if part.title == paginate.current_page %}
        <span class="cm-pagination-item cm-pagination-item--current pagination__page pagination__page--current">{{ part.title }}</span>
      {% else %}
        <span class="cm-pagination-item cm-pagination-item--dots pagination__page">{{ part.title }}</span>
      {% endif %}
    {% endif %}
  {% endfor %}
  {% if paginate.next.is_link %}
    <a onclick="BoosterTheme.ELEMENTS.renderChangePage(event, this, true)" href="{{ paginate.next.url }}" class="cm-pagination-item cm-pagination-item--next pagination__page" aria-label="Next page">
      <svg viewBox="0 0 24 24"><polygon points="6 4 18 12 6 20 6 4"></polygon></svg>
    </a>
  {% endif %}
</div>
{% endif %}