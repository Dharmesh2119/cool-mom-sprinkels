{% case template %}
    {% when 'index' %}
        <style>
        #shopify-section-footer, #shopify-section-subfooter {
            margin-bottom: 0px;
        }

        .gallery__default {
            display: block;
        }

        .gallery__vertical {
            display: none;
        }

        .wrapper--bottom {
            padding-top: 0px;
        }
        </style>
        {% section 'api__upsell' %}
    {% when 'product' %}
        <style>
        .wrapper--bottom {
            padding-top: 0px !important;
        }
        #shopify-section-info-badges:empty {
            display: none !important;
        }
        </style>
{% endcase %}

{% if template contains 'product' or template contains 'our-story' or page.handle == 'our-story' or template contains 'wholesale' or page.handle contains 'wholesale' %}
<style>
  .wrapper--bottom {
    padding-top: 0px !important;
  }
  #shopify-section-info-badges:empty {
    display: none !important;
  }
</style>
{% endif %}