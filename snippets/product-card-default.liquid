{% assign prod = product | default: product_card_default %}
{%- assign first_variant = prod.selected_or_first_available_variant | default: prod.variants.first -%}

<div class="card--default {% unless prod.available %}card--soldout{% endunless %} card--{{settings.cardStyle}}">
  <div class="card__img-wrap">
    <a class="card__img-link" href="{{ prod.url | within: collection }}" aria-label="{{ prod.title | escape }}">
      {% if prod.featured_image %}
        <img src="{{ prod.featured_image | image_url: width: 600 }}" alt="{{ prod.title | escape }}" loading="lazy" width="300" height="300">
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'svg__thumb' }}
      {% endif %}
    </a>

    {% if prod.available == false %}
      <div class="card__tags">
        <span class="tag tag--soldout">{{ 'general.buttons.sold_out' | t }}</span>
      </div>
    {% endif %}

    {% if first_variant.available %}
      <button type="button" class="cm-product-card__atc"
        data-buy-button="{{ prod.id }}"
        data-original-text="ADD TO CART"
        onclick="event.preventDefault(); event.stopPropagation(); BoosterTheme.cart.addToCartJSON(event, {items: [{id: {{ first_variant.id }}, quantity: 1}]});"
        aria-label="Add {{ prod.title | escape }} to cart">
        <svg class="cm-product-card__atc-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="width: 16px; height: 16px; min-width: 16px; min-height: 16px; flex-shrink: 0;">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M5 4C4.44772 4 4 4.44772 4 5L2.2 19C2.1 19.8 2.5 20.6 3.1 21.1C3.7 21.7 4.5 22 5.3 22H18.7C19.5 22 20.3 21.7 20.9 21.1C21.5 20.6 21.9 19.8 21.8 19L20 5C20 4.44772 19.5523 4 19 4H5ZM8.5 7C8.5 6.44772 8.94772 6 9.5 6C10.0523 6 10.5 6.44772 10.5 7C10.5 7.82843 11.1716 8.5 12 8.5C12.8284 8.5 13.5 7.82843 13.5 7C13.5 6.44772 13.9477 6 14.5 6C15.0523 6 15.5 6.44772 15.5 7C15.5 10.933 13.933 10.5 12 10.5C10.067 10.5 8.5 8.933 8.5 7Z" fill="#ffffff"/>
        </svg>
        <span data-button-text>ADD TO CART</span>
      </button>
    {% else %}
      <button type="button" class="cm-product-card__atc" disabled aria-label="Sold out" data-original-text="SOLD OUT">
        <span data-button-text>SOLD OUT</span>
      </button>
    {% endif %}
  </div>

  <div class="card__info">
    <a class="card__brand" href="{{ prod.vendor | url_for_vendor }}">
      {{ prod.vendor | default: 'Cool mom sprinkles' }}
    </a>
    <a class="card__title" href="{{ prod.url | within: collection }}">
      {{ prod.title }}
    </a>
    {% render 'cm-product-rating', prod: prod, format: 'card_default' %}
    <span class="card__price">
      {% if prod.price_varies %}From {% endif %}{{ prod.price | money }}
    </span>
  </div>
</div>