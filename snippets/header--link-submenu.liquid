{% assign link_title_clean = link.title | strip | downcase %}

{% if link_title_clean == 'featured' %}
<div class="cm-nav-submenu cm-megamenu-featured fancy-scroll">
  <div class="cm-featured-grid">
    {% for sub_link in link.links %}
      {% assign coll = sub_link.object %}
      {% if coll == blank or coll.image == blank %}
        {% if sub_link.url contains '/collections/' %}
          {% assign ch = sub_link.url | split: '/collections/' | last | split: '?' | first | split: '/' | first %}
          {% assign coll = collections[ch] %}
        {% endif %}
      {% endif %}
      <a href="{{ sub_link.url }}" class="cm-featured-card">
        <div class="cm-featured-img-wrap">
          {% assign feat_img = coll.image %}
          {% if feat_img == blank %}
            {% assign feat_img = coll.products.first.featured_image %}
          {% endif %}
          {% if feat_img != blank %}
            <img 
              src="{{ feat_img | img_url: '900x' }}" 
              alt="{{ sub_link.title | escape }}" 
              loading="lazy" 
              class="cm-featured-img">
          {% else %}
            <div class="cm-featured-img-placeholder"></div>
          {% endif %}
        </div>
        <span class="cm-featured-title">{{ sub_link.title }}</span>
      </a>
    {% endfor %}
  </div>
</div>
{% elsif link_title_clean contains 'shop sprinkles by' %}
<div class="cm-nav-submenu cm-dropdown-sprinkles fancy-scroll">
  <div class="cm-dropdown-list">
    {% for sub_link in link.links %}
      {% assign st = sub_link.title | split: '|' %}
      {% assign icon_name = '' %}
      {% assign link_title = sub_link.title %}
      {% assign link_desc = '' %}
      {% if st.size > 1 %}
        {% for part in st %}
          {% assign p = part | strip | split: ':' %}
          {% if p.size > 1 %}
            {% assign ptype = p[0] | strip | downcase %}
            {% if ptype == 'text' %}
              {% assign link_title = p[1] | strip %}
            {% elsif ptype == 'desc' %}
              {% assign link_desc = p[1] | strip %}
            {% elsif ptype == 'icon' %}
              {% assign icon_name = p[1] | strip | downcase %}
            {% endif %}
          {% endif %}
        {% endfor %}
      {% endif %}

      <a href="{{ sub_link.url }}" class="cm-dropdown-item">
        <span class="cm-dropdown-icon">
          {% if icon_name == 'selfie' or icon_name == 'event' or link_title contains 'Event' %}
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="3"></rect><line x1="9" y1="2" x2="15" y2="2"></line><line x1="9" y1="4" x2="15" y2="4"></line><circle cx="12" cy="11" r="2.5"></circle><path d="M7.5 18a4.5 4.5 0 0 1 9 0"></path></svg>
          {% elsif icon_name == 'gift' or icon_name == 'holiday' or link_title contains 'Holiday' %}
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 12 20 22 4 22 4 12"></polyline><rect x="2" y="7" width="20" height="5"></rect><line x1="12" y1="22" x2="12" y2="7"></line><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path></svg>
          {% elsif icon_name == 'trees' or icon_name == 'season' or link_title contains 'Season' %}
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12A10 10 0 0 0 2 12z"></path><path d="M12 12v7a2 2 0 0 0 4 0"></path><line x1="12" y1="2" x2="12" y2="4"></line></svg>
          {% elsif icon_name == 'palette' or icon_name == 'color' or link_title contains 'Color' %}
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="13.5" cy="6.5" r=".5" fill="currentColor"></circle><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"></circle><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"></circle><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"></circle><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.992 6.5 17.5 2 12 2z"></path></svg>
          {% elsif icon_name == 'flower' or icon_name == 'natural' or link_title contains 'Natural' %}
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M12 2a3 3 0 0 0-3 3v1a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"></path><path d="M12 18a3 3 0 0 0-3 3v1a3 3 0 0 0 6 0v-1a3 3 0 0 0-3-3z"></path><path d="M22 12a3 3 0 0 0-3-3h-1a3 3 0 0 0 0 6h1a3 3 0 0 0 3-3z"></path><path d="M6 12a3 3 0 0 0-3-3H2a3 3 0 0 0 0 6h1a3 3 0 0 0 3-3z"></path><path d="M19.07 4.93a3 3 0 0 0-4.24 0l-.71.71a3 3 0 0 0 4.24 4.24l.71-.71a3 3 0 0 0 0-4.24z"></path><path d="M5.64 18.36a3 3 0 0 0 4.24 0l.71-.71a3 3 0 0 0-4.24-4.24l-.71.71a3 3 0 0 0 0 4.24z"></path></svg>
          {% else %}
            <i class="nav__link__icon uil uil-{{ icon_name | default: 'angle-right' }}"></i>
          {% endif %}
        </span>
        <div class="cm-dropdown-text">
          <span class="cm-dropdown-title">{{ link_title }}</span>
          {% if link_desc != blank %}
            <span class="cm-dropdown-desc">{{ link_desc }}</span>
          {% endif %}
        </div>
      </a>
    {% endfor %}
  </div>
</div>
{% elsif section.settings.megamenu %}
{% assign megamenu = false %}
{% assign check_products = link.links | where: "type", "product_link" %}
{% assign cp_size = check_products.size %}
{% assign check_collections = link.links | where: "type", "collection_link" %}
{% assign cc_size = check_collections.size %}
{% assign subsubmenu = 0 %}
{% assign has_submenu = false %}
{% assign check_list = false %}
{% for sublink in link.links %}
    {% if sublink.links != empty %}
        {% assign has_submenu = true %}
        {% assign subsubmenu = subsubmenu | plus: 1 %}
        {% if sublink.type == "collection_link" %}
            {% assign cc_size = cc_size | minus: 1 %}
        {% elsif sublink.type == "product_link" %}
            {% assign cp_size = cp_size | minus: 1 %}
        {% endif %}
        {% assign check_submenu_list = sublink.links | where: "type", "product_link" %}
        {% if check_submenu_list.size == sublink.links.size %}
            {% assign check_list = true %}
        {% endif %}
        {% break %}
    {% endif %}
{% endfor %}

{% assign combined = cp_size | plus: cc_size %}
{% if check_list or link.links.size > 1 and subsubmenu > 2 %}
    {% assign megamenu = true %}
{% elsif combined >= 2 %}
    {% assign megamenu = true %}
{% elsif combined > 0 and has_submenu %}
{% endif %}

{% unless megamenu %}
<div class="nav__submenu nav__submenu--regular fancy-scroll">
    {% for sub_link in link.links %}
        <span class="nav__link__holder {% if sub_link.active or sub_link.child_active %}nav__link--active{% endif %}">
            <a href="{{sub_link.url}}" class="nav__link">
                {% render 'header--link-elements' with sub_link.title as text %}
            </a>
            {% if sub_link.links.size > 0 %}
                <div class="nav__submenu nav__submenu--regular">
                    {% for d_link in sub_link.links %}
                        <span class="nav__link__holder {% if d_link.active or d_link.child_active %}nav__link--active{% endif %}">
                            <a href="{{d_link.url}}" class="nav__link">
                                {% render 'header--link-elements' with d_link.title as text %}
                            </a>
                        </span>
                    {% endfor %}
                </div>
            {% endif %}
        </span>
    {% endfor %}
</div>
{% else %}
{% assign csize = 12 | divided_by: link.links.size | at_least: 3 %}
<div class="nav__submenu nav__submenu--mega row fancy-scroll">
{% for sub_link in link.links %}
    {% if sub_link.links != empty %}
        {% assign plist = sub_link.links | where: 'type', 'product_link' %}
        {% if plist.size == sub_link.links.size %}
            <span class="nav__link__holder--mega col-md-{{csize}}">
                <div class="header__plist">
                    <a href="{{sub_link.url}}" class="nav__megamenu__title">{{sub_link.title}}</a>
                    {% for deeplink in sub_link.links %}
                        {% assign prdt = deeplink.object %}
                        <div class="header__plist--item">
                            <a href="{{prdt.url}}"><img height="{{prdt.featured_image.height}}" width="{{prdt.featured_image.width}}" src="{{prdt.featured_image | img_url: '80x'}}" class="header__plist--image"></a>
                            <div class="header__plist--info">
                                <a href="{{prdt.url}}" class="header__plist--name">{{prdt.title}}</a>
                                <span class="header__plist--price">{{prdt.price | money | strip_html}}</span>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </span>                
        {% else %}
            <span class="nav__link__holder--mega col-md-{{csize}}">
                <div class="nav__megamenu__menu">
                    <a href="{{sub_link.url}}" class="nav__megamenu__title">{{sub_link.title}}</a>
                    {% for slink in sub_link.links %}
                        <a href="{{slink.url}}" class="nav__megamenu__link">{{slink.title}}</a>
                    {% endfor %}
                </div>
            </span>
        {% endif %}
        {% else %}
            {% case sub_link.type %}
                {% when 'product_link' %}
                <span class="nav__link__holder--mega col-md-{{csize}}">
                    {% render 'product-card-no-button' with sub_link.object as product %}
                </span>
                {% when 'collection_link' %}
                <span class="nav__link__holder--mega col-md-{{csize}}">
                    {% render 'collection-card' with sub_link.object as collection %}
                </span>
            {% endcase %}
    {% endif %}
{% endfor %}
</div>
{% endunless %}
{% else %}
<div class="nav__submenu nav__submenu--regular fancy-scroll">
    {% for sub_link in link.links %}
        <span class="nav__link__holder {% if sub_link.active or sub_link.child_active %}nav__link--active{% endif %}">
            <a href="{{sub_link.url}}" class="nav__link">
                {% render 'header--link-elements' with sub_link.title as text %}
            </a>
            {% if sub_link.links.size > 0 %}
                {% render 'header--link-submenu', link: sub_link, section: section %}
            {% endif %}
        </span>
    {% endfor %}
</div>
{% endif %}